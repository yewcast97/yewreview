{
  "name": "yewreview",
  "version": "1.0.0",
  "description": "A local AI agent that writes professional market research reports as HTML.",
  "type": "module",
  "private": true,
  "bin": {
    "yewreview": "./src/main.ts"
  },
  "scripts": {
    "dev": "bun src/main.ts",
    "dev:claudecode": "bun src/main.ts claudecode",
    "dev:opencode": "bun src/main.ts opencode",
    "build": "bun scripts/build.ts",
    "install:cli": "bun scripts/build.ts --install",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test:seikan": "uv run --project vendor/seikan pytest vendor/seikan/tests -q",
    "typecheck:seikan": "uv run --directory vendor/seikan mypy",
    "lint:seikan": "uv run --directory vendor/seikan ruff check"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@shikijs/core": "^4.4.2",
    "@shikijs/engine-javascript": "^4.4.2",
    "@shikijs/langs": "^4.4.2",
    "@shikijs/themes": "^4.4.2",
    "dompurify": "^3",
    "echarts": "^6.0.0",
    "marked": "^16",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "opencode-ai": "1.18.18",
    "typescript": "^7.0.2"
  }
}
